{
  "name": "imizi",
  "version": "1.0.0",
  "private": true,
  "description": "Imizi — Rwanda-first real estate marketplace, booking, payments, maps, messaging, and property operations platform.",
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:packages": "npm run build -w @imizi/types && npm run build -w @imizi/config && npm run build -w @imizi/auth && npm run build -w @imizi/database && npm run build -w @imizi/validation && npm run build -w @imizi/domain && npm run build -w @imizi/maps && npm run build -w @imizi/payments",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm run test -w @imizi/domain",
    "dev:api": "npm run start:dev -w @imizi/api",
    "dev:web": "npm run dev -w @imizi/web",
    "dev:admin": "npm run dev -w @imizi/web -- --port 3002",
    "mobile:typecheck": "npm --prefix apps/mobile exec tsc -- --noEmit",
    "mobile:doctor": "npm --prefix apps/mobile exec expo-doctor",
    "db:generate": "npm run migrate -w @imizi/database",
    "db:migrate": "npm run migrate -w @imizi/database",
    "db:seed": "npm run seed -w @imizi/database",
    "db:sync:locations": "npm run locations:sync -w @imizi/database",
    "db:smoke": "npm run smoke -w @imizi/database"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
