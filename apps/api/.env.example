# Imizi API local development
# Docker Compose exposes PostgreSQL on host port 5433.
DATABASE_URL=postgresql://imizi:imizi_dev@127.0.0.1:5433/imizi
REDIS_URL=redis://127.0.0.1:6379
OPENSEARCH_URL=http://127.0.0.1:9200
PORT=4000
API_PREFIX=/api/v1
DEFAULT_CURRENCY=RWF
DEFAULT_COUNTRY=RW

# Optional integrations
MTN_MOMO_CALLBACK_SECRET=
SENTRY_DSN=
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=imizi-public
S3_BUCKET_PRIVATE=imizi-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_BASE_URL=
