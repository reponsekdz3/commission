NODE_ENV=development
APP_NAME=Imizi
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_PREFIX=/api/v1
PORT=4000

DATABASE_URL=postgresql://imizi:imizi_dev@localhost:5432/imizi?schema=public
DB_POOL_MAX=20
DB_SSL=false
REDIS_URL=redis://localhost:6379
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=imizi-listings
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

JWT_ACCESS_SECRET=replace-with-32-plus-char-access-secret
JWT_REFRESH_SECRET=replace-with-32-plus-char-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=imizi-public
S3_BUCKET_PRIVATE=imizi-private
S3_ACCESS_KEY=imizi
S3_SECRET_KEY=imizi_secret
CDN_BASE_URL=http://localhost:9000/imizi-public

MAPS_PROVIDER=mapbox
MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=http://localhost:4000/api/v1/payments/webhooks/mtn
MTN_MOMO_CALLBACK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_REDIRECT_URL=http://localhost:3000/payments/return
FLUTTERWAVE_PAYMENT_OPTIONS=card,mobilemoneyrwanda

SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=imizi-api
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=
RESEND_API_KEY=
EMAIL_FROM=Imizi <noreply@example.com>
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
MAX_MEDIA_BYTES=262144000
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
PROMETHEUS_ENABLED=true

DEFAULT_CURRENCY=RWF
DEFAULT_COUNTRY=RW
DEFAULT_LOCALE=rw
DEFAULT_TIMEZONE=Africa/Kigali
PLATFORM_COMMISSION_BPS=500
